# Canonical origin of the published site (no trailing slash). Used for
# metadataBase, canonical URLs, sitemap.xml, robots.txt and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://example.com

# The Hlou control plane. Forms post to
# ${NEXT_PUBLIC_HLOU_API_URL}/api/v1/public/forms/${NEXT_PUBLIC_HLOU_PROJECT_ID}/{formKey}
NEXT_PUBLIC_HLOU_API_URL=http://localhost:3000
NEXT_PUBLIC_HLOU_PROJECT_ID=proj-real-estate

# Optional. When set, the Plausible script is injected on every page.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Cloudflare Web Analytics beacon. Written by the builder from the project's
# RUM site; public by construction, since it ships in every page's HTML.
NEXT_PUBLIC_CF_BEACON_TOKEN=
