{
  "name": "hlou-starter-next",
  "version": "0.1.0",
  "private": true,
  "description": "The Next.js starter for Hlou sites: write the site as a keyed JSON spec in hlou/site/, render it locally, bring it to Hlou.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hloudev/hlou-starter-next.git"
  },
  "homepage": "https://github.com/hloudev/hlou-starter-next#readme",
  "bugs": {
    "url": "https://github.com/hloudev/hlou-starter-next/issues"
  },
  "scripts": {
    "dev": "node scripts/spec-build.mjs --dev",
    "prebuild": "node scripts/spec-build.mjs --if-spec && node scripts/og-image.mjs",
    "build": "next build",
    "start": "next start",
    "hlou:compile": "node scripts/spec-build.mjs",
    "hlou:pack": "node scripts/pack.mjs",
    "lint": "eslint",
    "format": "prettier --write .",
    "check-types": "tsc --noEmit",
    "preview": "node scripts/serve-out.mjs",
    "optimise-images": "node scripts/optimise-images.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "next-intl": "^4.14.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.7",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=24"
  }
}
