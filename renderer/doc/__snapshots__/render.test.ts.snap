exports[`renderDoc > draws every fixture page as Puck did — canvas, no chrome > canvas, no chrome › page-contact 1`] = `"<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/><div class="hl-site-scope" lang="en" dir="ltr" style="--site-accent:light-dark(#b0552f, #c66943);--site-accent-soft:color-mix(in srgb, light-dark(#b0552f, #c66943) 15%, transparent);--site-paper:light-dark(#f4f1ea, #181611);--site-ink:light-dark(#1c1a17, #eae7e3);--site-ink-soft:color-mix(in srgb, light-dark(#1c1a17, #eae7e3) 66%, light-dark(#f4f1ea, #181611));--site-heading-font:var(--font-instrument-serif, &#x27;Instrument Serif&#x27;), Georgia, serif;--site-body-font:var(--font-inter, &#x27;Inter&#x27;), Inter, sans-serif;--site-radius:10px;--site-pad-y:54px;--site-pad-x:40px;--site-type-xs:11px;--site-type-sm:14px;--site-type-md:19px;--site-type-lg:26px;--site-type-xl:34px;--site-color-accent:light-dark(#b0552f, #c66943);--site-color-paper:light-dark(#f4f1ea, #181611);--site-color-ink:light-dark(#1c1a17, #eae7e3);--site-font-heading:var(--font-instrument-serif, &#x27;Instrument Serif&#x27;), Georgia, serif;--site-font-body:var(--font-inter, &#x27;Inter&#x27;), Inter, sans-serif"><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:wght@400;500;700&amp;family=Inter:wght@400;500;700&amp;display=swap"/><section data-hl-block="blk-contact-head" data-hl-block-type="pageHeader" lang="en" dir="ltr" class="hl-blk hl-blk-pageHeader border-b border-site-hairline py-13.5"><div class="relative mx-auto w-full max-w-site-content"><p class="mb-3.5 text-site-xs uppercase tracking-[0.14em] text-site-accent" data-hl-field="eyebrow">Contact</p><h1 class="max-w-[18ch] font-heading text-site-xl leading-[1.06] tracking-[-0.02em] md:text-[length:calc(var(--site-type-xl)*1.2)] rtl:tracking-normal" data-hl-field="title">Nous écrire</h1><div class="hl-float-layer pointer-events-none absolute inset-0 z-10 *:pointer-events-auto"></div></div></section><section data-hl-block="blk-contact-form" data-hl-block-type="form" lang="en" dir="ltr" class="hl-blk hl-blk-form"><div class="relative mx-auto w-full max-w-site-content"><div class="mb-4.5 flex items-center gap-2.5"><h2 class="mb-5.5 text-site-lg" data-hl-field="title">Demande de réservation</h2><span class="inline-flex items-center gap-1.25 rounded-site-pill border border-dashed border-site-accent/50 bg-site-accent-soft px-2 py-0.75 font-mono text-site-xs text-site-accent">form booking</span></div><p class="-mt-3 mb-5.5 max-w-[60ch] text-site-sm text-site-ink-soft" data-hl-field="description">Une date en tête ? Nous répondons sous 24 h.</p><form class="grid max-w-[560px] gap-3.5" data-hl-field="form" noValidate="" data-hl-form="booking" data-hl-endpoint="/api/forms"><div class="grid gap-1.5"><label class="text-site-sm" for="blk-contact-form-name">Nom<span class="ms-0.5 text-site-accent" aria-hidden="true">*</span></label><input id="blk-contact-form-name" type="text" class="w-full rounded-site border border-site-hairline-strong bg-site-card px-3 py-2.25 font-[inherit] text-site-sm leading-[inherit] text-site-ink focus:border-site-accent focus:outline-none aria-invalid:border-site-error disabled:cursor-not-allowed" required="" name="name"/></div><div class="grid gap-1.5"><label class="text-site-sm" for="blk-contact-form-email">E-mail<span class="ms-0.5 text-site-accent" aria-hidden="true">*</span></label><input id="blk-contact-form-email" type="email" class="w-full rounded-site border border-site-hairline-strong bg-site-card px-3 py-2.25 font-[inherit] text-site-sm leading-[inherit] text-site-ink focus:border-site-accent focus:outline-none aria-invalid:border-site-error disabled:cursor-not-allowed" required="" name="email"/></div><div class="grid gap-1.5"><label class="text-site-sm" for="blk-contact-form-arrival">Arrivée<span class="ms-0.5 text-site-accent" aria-hidden="true">*</span></label><input id="blk-contact-form-arrival" type="date" class="w-full rounded-site border border-site-hairline-strong bg-site-card px-3 py-2.25 font-[inherit] text-site-sm leading-[inherit] text-site-ink focus:border-site-accent focus:outline-none aria-invalid:border-site-error disabled:cursor-not-allowed" required="" name="arrival"/></div><div class="grid gap-1.5"><label class="text-site-sm" for="blk-contact-form-guests">Voyageurs</label><input id="blk-contact-form-guests" type="number" class="w-full rounded-site border border-site-hairline-strong bg-site-card px-3 py-2.25 font-[inherit] text-site-sm leading-[inherit] text-site-ink focus:border-site-accent focus:outline-none aria-invalid:border-site-error disabled:cursor-not-allowed" name="guests"/></div><div class="grid gap-1.5"><label class="text-site-sm" for="blk-contact-form-room">Chambre</label><select id="blk-contact-form-room" name="room" class="w-full rounded-site border border-site-hairline-strong bg-site-card px-3 py-2.25 font-[inherit] text-site-sm leading-[inherit] text-site-ink focus:border-site-accent focus:outline-none aria-invalid:border-site-error disabled:cursor-not-allowed"><option value="" selected=""></option><option value="jasmin">Jasmin</option><option value="olivier">Olivier</option></select></div><div class="grid gap-1.5"><label class="text-site-sm" for="blk-contact-form-message">Message</label><textarea id="blk-contact-form-message" name="message" class="w-full rounded-site border border-site-hairline-strong bg-site-card px-3 py-2.25 font-[inherit] text-site-sm leading-[inherit] text-site-ink focus:border-site-accent focus:outline-none aria-invalid:border-site-error disabled:cursor-not-allowed min-h-30 resize-y"></textarea></div><label class="flex items-center gap-2 text-site-sm" for="blk-contact-form-newsletter"><input id="blk-contact-form-newsletter" type="checkbox" name="newsletter"/><span>Recevoir le journal</span></label><div class="absolute -start-[9999px] size-px overflow-hidden" aria-hidden="true"><input type="text" tabindex="-1" autoComplete="off" name="website"/></div><div><button type="submit" class="inline-flex cursor-pointer items-center gap-2 whitespace-nowrap rounded-site border border-transparent px-4.25 py-2.25 font-[inherit] text-site-sm leading-[1.2] hover:no-underline hover:brightness-95 disabled:cursor-not-allowed disabled:opacity-55 aria-disabled:cursor-not-allowed aria-disabled:opacity-55 border-site-accent bg-site-accent text-site-on-accent disabled:cursor-not-allowed disabled:opacity-55" data-hl-field="submit">Envoyer</button></div></form><div class="hl-float-layer pointer-events-none absolute inset-0 z-10 *:pointer-events-auto"></div></div></section><section data-hl-block="blk-contact-map" data-hl-block-type="section" lang="en" dir="ltr" class="hl-blk hl-blk-section"><div class="relative mx-auto w-full max-w-site-content in-[.hl-slot]:max-w-none min-h-32 has-[[data-hl-block]]:min-h-0 [&amp;:has([data-hl-block])&gt;.hl-planned]:hidden"><div class="hl-planned pointer-events-none absolute inset-0 flex items-center gap-3.5 rounded-site border border-dashed border-site-hairline-strong bg-[repeating-linear-gradient(-45deg,transparent,transparent_10px,color-mix(in_srgb,var(--site-ink)_3%,transparent)_10px,color-mix(in_srgb,var(--site-ink)_3%,transparent)_20px)] px-6 text-site-ink-soft" role="note"><span class="rounded-site-pill border border-site-hairline-strong px-2 py-1 font-mono text-site-xs tracking-[0.08em] uppercase">map</span><span class="text-site-sm">Accès (à composer)</span></div><div class="hl-slot grid content-start gap-[var(--site-slot-gap,18px)]"></div><div class="hl-float-layer pointer-events-none absolute inset-0 z-10 *:pointer-events-auto"></div></div></section></div>"`;

