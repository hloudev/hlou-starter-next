et-0 z-10 *:pointer-events-auto"></div></div></section><section data-hl-block="blk-contact-form" data-hl-block-type="form" lang="fr" dir="ltr" class="hl-blk hl-blk-form"><div class="relative mx-auto w-full max-w-site-content"><div class="mb-4.5 flex items-center gap-2.5"><h2 class="mb-5.5 text-site-lg" data-hl-field="title">Demande de réservation</h2><span class="inline-flex items-center gap-1.25 rounded-site-pill border border-dashed border-site-accent/50 bg-site-accent-soft px-2 py-0.75 font-mono text-site-xs text-site-accent">form booking</span></div><p class="-mt-3 mb-5.5 max-w-[60ch] text-site-sm text-site-ink-soft" data-hl-field="description">Une date en tête ? Nous répondons sous 24 h.</p><form class="grid max-w-[560px] gap-3.5" data-hl-field="form" noValidate="" data-hl-form="booking" data-hl-endpoint="/api/forms"><div class="grid gap-1.5"><label class="text-site-sm" for="blk-contact-form-name">Nom<span class="ms-0.5 text-site-accent" aria-hidden="true">*</span></label><input id="blk-contact-form-name" type="text" class="w-full rounded-site border border-site-hairline-strong bg-site-card px-3 py-2.25 font-[inherit] text-site-sm leading-[inherit] text-site-ink focus:border-site-accent focus:outline-none aria-invalid:border-site-error disabled:cursor-not-allowed" required="" name="name"/></div><div class="grid gap-1.5"><label class="text-site-sm" for="blk-contact-form-email">E-mail<span class="ms-0.5 text-site-accent" aria-hidden="true">*</span></label><input id="blk-contact-form-email" type="email" class="w-full rounded-site border border-site-hairline-strong bg-site-card px-3 py-2.25 font-[inherit] text-site-sm leading-[inherit] text-site-ink focus:border-site-accent focus:outline-none aria-invalid:border-site-error disabled:cursor-not-allowed" required="" name="email"/></div><div class="grid gap-1.5"><label class="text-site-sm" for="blk-contact-form-arrival">Arrivée<span class="ms-0.5 text-site-accent" aria-hidden="true">*</span></label><input id="blk-contact-form-arrival" type="date" class="w-full rounded-site border border-site-hairline-strong bg-site-card px-3 py-2.25 font-[inherit] text-site-sm leading-[inherit] text-site-ink focus:border-site-accent focus:outline-none aria-invalid:border-site-error disabled:cursor-not-allowed" required="" name="arrival"/></div><div class="grid gap-1.5"><label class="text-site-sm" for="blk-contact-form-guests">Voyageurs</label><input id="blk-contact-form-guests" type="number" class="w-full rounded-site border border-site-hairline-strong bg-site-card px-3 py-2.25 font-[inherit] text-site-sm leading-[inherit] text-site-ink focus:border-site-accent focus:outline-none aria-invalid:border-site-error disabled:cursor-not-allowed" name="guests"/></div><div class="grid gap-1.5"><label class="text-site-sm" for="blk-contact-form-room">Chambre</label><select id="blk-contact-form-room" name="room" class="w-full rounded-site border border-site-hairline-strong bg-site-card px-3 py-2.25 font-[inherit] text-site-sm leading-[inherit] text-site-ink focus:border-site-accent focus:outline-none aria-invalid:border-site-error disabled:cursor-not-allowed"><option value="" selected=""></option><option value="jasmin">Jasmin</option><option value="olivier">Olivier</option></select></div><div class="grid gap-1.5"><label class="text-site-sm" for="blk-contact-form-message">Message</label><textarea id="blk-contact-form-message" name="message" class="w-full rounded-site border border-site-hairline-strong bg-site-card px-3 py-2.25 font-[inherit] text-site-sm leading-[inherit] text-site-ink focus:border-site-accent focus:outline-none aria-invalid:border-site-error disabled:cursor-not-allowed min-h-30 resize-y"></textarea></div><label class="flex items-center gap-2 text-site-sm" for="blk-contact-form-newsletter"><input id="blk-contact-form-newsletter" type="checkbox" name="newsletter"/><span>Recevoir le journal</span></label><div class="absolute -start-[9999px] size-px overflow-hidden" aria-hidden="true"><input type="text" tabindex="-1" autoComplete="off" name="website"/></div><div><button type="submit" class="inline-flex cursor-pointer items-center gap-2 whitespace-nowrap rounded-site border border-transparent px-4.25 py-2.25 font-[inherit] text-site-sm leading-[1.2] hover:no-underline hover:brightness-95 disabled:cursor-not-allowed disabled:opacity-55 aria-disabled:cursor-not-allowed aria-disabled:opacity-55 border-site-accent bg-site-accent text-site-on-accent disabled:cursor-not-allowed disabled:opacity-55" data-hl-field="submit">Envoyer</button></div></form><div class="hl-float-layer pointer-events-none absolute inset-0 z-10 *:pointer-events-auto"></div></div></section><section data-hl-block="blk-contact-map" data-hl-block-type="section" lang="fr" dir="ltr" class="hl-blk hl-blk-section"><div class="relative mx-auto w-full max-w-site-content in-[.hl-slot]:max-w-none min-h-32 has-[[data-hl-block]]:min-h-0 [&amp;:has([data-hl-block])&gt;.hl-planned]:hidden"><div class="hl-planned pointer-events-none absolute inset-0 flex items-center gap-3.5 rounded-site border border-dashed border-site-hairline-strong bg-[repeating-linear-gradient(-45deg,transparent,transparent_10px,color-mix(in_srgb,var(--site-ink)_3%,transparent)_10px,color-mix(in_srgb,var(--site-ink)_3%,transparent)_20px)] px-6 text-site-ink-soft" role="note"><span class="rounded-site-pill border border-site-hairline-strong px-2 py-1 font-mono text-site-xs tracking-[0.08em] uppercase">map</span><span class="text-site-sm">Accès (à composer)</span></div><div class="hl-slot grid content-start gap-[var(--site-slot-gap,18px)]"></div><div class="hl-float-layer pointer-events-none absolute inset-0 z-10 *:pointer-events-auto"></div></div></section></div>"`;

exports[`renderDoc > draws every fixture page as Puck did — preview, no chrome > preview, no chrome › page-home 1`] = `"<link rel="preload" as="image" href="/media/asset-hero/v1/hero.jpg" fetchPriority="high"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/><div class="hl-site-scope" lang="fr" dir="ltr" style="--site-accent:light-dark(#b0552f, #c66943);--site-accent-soft:color-mix(in srgb, light-dark(#b0552f, #c66943) 15%, transparent);--site-paper:light-dark(#f4f1ea, #181611);--site-ink:light-dark(#1c1a17, #eae7e3);--site-ink-soft:color-mix(in srgb, light-dark(#1c1a17, #eae7e3) 66%, light-dark(#f4f1ea, #181611));--site-heading-font:var(--font-instrument-serif, &#x27;Instrument Serif&#x27;), Georgia, serif;--site-body-font:var(--font-inter, &#x27;Inter&#x27;), Inter, sans-serif;--site-radius:10px;--site-pad-y:54px;--site-pad-x:40px;--site-type-xs:11px;--site-type-sm:14px;--site-type-md:19px;--site-type-lg:26px;--site-type-xl:34px;--site-color-accent:light-dark(#b0552f, #c66943);--site-color-paper:light-dark(#f4f1ea, #181611);--site-color-ink:light-dark(#1c1a17, #eae7e3);--site-font-heading:var(--font-instrument-serif, &#x27;Instrument Serif&#x27;), Georgia, serif;--site-font-body:var(--font-inter, &#x27;Inter&#x27;), Inter, sans-serif"><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:wght@400;500;700&amp;family=Inter:wght@400;500;700&amp;display=swap"/><section data-hl-block="blk-home-hero" data-hl-block-type="hero" lang="fr" dir="ltr" class="hl-blk hl-blk-hero isolate"><div class="relative mx-auto grid w-full max-w-site-content items-center md:grid-cols-[1.1fr_0.9fr] gap-8 md:gap-12"><div class=""><p class="mb-3.5 text-site-xs uppercase tracking-[0.14em] text-site-accent" data-hl-field="eyebrow">Maison d’hôtes · Tunis</p><h1 class="mb-4 font-heading text-site-xl leading-none font-normal tracking-tight text-pretty md:text-5xl rtl:tracking-normal" data-hl-field="title">Des chambres qui prennent leur temps</h1><div class="hl-rich mb-6 max-w-sm text-site-sm leading-relaxed text-site-ink-soft" data-hl-field="description"><p>Quatre chambres, un patio et une table d’hôtes, à dix minutes de la médina.</p></div><div class="flex flex-wrap gap-2.5" data-hl-field="buttons"><a class="inline-flex cursor-pointer items-center gap-2 whitespace-nowrap rounded-site border border-transparent px-4.25 py-2.25 font-[inherit] text-site-sm leading-[1.2] hover:no-underline hover:brightness-95 disabled:cursor-not-allowed disabled:opacity-55 aria-disabled:cursor-not-allowed aria-disabled:opacity-55 border-site-accent bg-site-accent text-site-on-accent" href="/rooms" data-hl-field="buttons[0]">Voir les chambres</a><a class="inline-flex cursor-pointer items-center gap-2 whitespace-nowrap rounded-site border border-transparent px-4.25 py-2.25 font-[inherit] text-site-sm leading-[1.2] hover:no-underline hover:brightness-95 disabled:cursor-not-allowed disabled:opacity-55 aria-disabled:cursor-not-allowed aria-disabled:opacity-55 border-site-hairline-strong bg-transparent text-site-ink" href="/contact" data-hl-field="buttons[1]">Nous écrire</a></div></div><div class="relative overflow-hidden rounded-site bg-site-media-fill aspect-4/5" data-hl-field="image"><img class="size-full object-cover" alt="Le patio au matin" decoding="async" fetchPriority="high" src="/media/asset-hero/v1/hero.jpg" width="1600" height="2000"/></div><div class="hl-float-layer pointer-events-none absolute inset-0 z-10 *:pointer-events-auto"><div data-hl-block="blk-home-hero-badge" data-hl-block-type="floating" lang="fr" dir="ltr" class="hl-blk hl-blk-floating p-0 absolute start-(--fs) end-(--fe) top-(--ft) bottom-(--fb) z-(--fz) translate-x-(--ftx) translate-y-(--fty) free:static free:translate-none w-(--fw) float-at-base md:float-at-md" style="--fs-base:auto;--fe-base:16px;--ft-base:16px;--fb-base:auto;--ftx-base:0px;--fty-base:0px;--fw-base:auto;--fz-base:1;--fs-md:auto;--fe-md:32px;--ft-md:32px;--fb-md:auto;--ftx-md:0px;--fty-md:0px;--fw-md:auto;--fz-md:1"><div class="hl-slot grid content-start gap-[var(--site-slot-gap,18px)] hl-float__content"><div data-hl-block="blk-home-hero-badge-label" data-hl-block-type="button" lang="fr" dir="ltr" class="hl-blk hl-blk-button [--site-pad-y:18px]"><div class="mx-auto flex w-full max-w-site-content flex-wrap gap-2.5 in-[.hl-slot]:max-w-none"><span class="inline-flex cursor-pointer items-center gap-2 whitespace-nowrap rounded-site border border-transparent px-4.25 py-2.25 font-[inherit] text-site-sm leading-[1.2] hover:no-underline hover:brightness-95 disabled:cursor-not-allowed disabled:opacity-55 aria-disabled:cursor-not-allowed aria-disabled:opacity-55 border-site-on-accent bg-site-on-accent text-site-accent" aria-disabled="true" data-hl-field="label">Nouveau</span></div></div></div></div></div></div></section><section data-hl-block="blk-home-stats" data-hl-block-type="stats" lang="fr" dir="ltr" class="hl-blk hl-blk-stats py-6.5 border-y border-site-hairline"><div class="relative mx-auto w-full max-w-site-content"><dl class="grid grid-cols-2 gap-5 max-[390px]:grid-cols-1 md:grid-cols-[repeat(var(--site-stats-cols,4),1fr)]" style="--site-stats-cols:4" data-hl-field="items"><div class="" data-hl-field="items[0]"><dd class="font-heading text-[length:calc(var(--site-type-lg)*1.15)] leading-none">4</dd><dt class="mt-1 text-site-xs text-site-ink-soft">chambres</dt></div><div class="" data-hl-field="items[1]"><dd class="font-heading text-[length:calc(var(--site-type-lg)*1.15)] leading-none">1932</dd><dt class="mt-1 text-site-xs text-site-ink-soft">année</dt></div><div class="" data-hl-field="items[2]"><dd class="font-heading text-[length:calc(var(--site-type-lg)*1.15)] leading-none">10 min</dd><dt class="mt-1 text-site-xs text-site-ink-soft">de la médina</dt></div><div class="" data-hl-field="items[3]"><dd class="font-heading text-[length:calc(var(--site-type-lg)*1.15)] leading-none">4,9</dd><dt class="mt-1 text-site-xs text-site-ink-soft">note</dt></div></dl><div class="hl-float-layer pointer-events-none absolute inset-0 z-10 *:pointer-events-auto"></div></div></section><section data-hl-block="blk-home-features" data-hl-block-type="featureGrid" lang="fr" dir="ltr" class="hl-blk hl-blk-featureGrid"><div class="relative mx-auto w-full max-w-site-content"><h2 class="mb-5.5 text-site-lg" data-hl-field="title">Ce qui fait la maison</h2><div class="grid grid-cols-1 gap-3.5 md:grid-cols-[repeat(var(--site-feature-cols,3),minmax(0,1fr))]" style="--site-feature-cols:3" data-hl-field="cards"><article class="rounded-site bg-[var(--site-blk-card-bg,var(--site-card))] p-4.5 border border-site-hairline-strong" data-hl-field="cards[0]"><span class="mb-3 grid size-8 place-items-center rounded-md bg-[var(--site-blk-icon-bg,var(--site-accent-soft))] text-site-sm text-[color:var(--site-blk-icon-color,var(--site-accent))]" aria-hidden="true"><span class="inline-grid shrink-0 place-items-center leading-none size-4.5" aria-hidden="true">☀</span></span><h3 class="mb-1.5 font-[inherit] text-site-sm">Le patio</h3><p class="text-site-sm leading-[1.55] text-site-ink-soft">Un jardin clos et un citronnier.</p></article><article class="rounded-site bg-[var(--site-blk-card-bg,var(--site-card))] p-4.5 border border-site-hairline-strong" data-hl-field="cards[1]"><span class="mb-3 grid size-8 place-items-center rounded-md bg-[var(--site-blk-icon-bg,var(--site-accent-soft))] text-site-sm text-[color:var(--site-blk-icon-color,var(--site-accent))]" aria-hidden="true"><span class="inline-grid shrink-0 place-items-center leading-none size-4.5" aria-hidden="true">◌</span></span><h3 class="mb-1.5 font-[inherit] text-site-sm">La table</h3><p class="text-site-sm leading-[1.55] text-site-ink-soft">Cuisine de saison, le soir.</p></article><article class="rounded-site bg-[var(--site-blk-card-bg,var(--site-card))] p-4.5 border border-site-hairline-strong" data-hl-field="cards[2]"><span class="mb-3 grid size-8 place-items-center rounded-md bg-[var(--site-blk-icon-bg,var(--site-accent-soft))] text-site-sm text-[color:var(--site-blk-icon-color,var(--site-accent))]" aria-hidden="true"><span class="inline-grid shrink-0 place-items-center leading-none size-4.5" aria-hidden="true">⌂</span></span><h3 class="mb-1.5 font-[inherit] text-site-sm">Le quartier</h3><p class="text-site-sm leading-[1.55] text-site-ink-soft">Dix minutes de la médina.</p></article></div><div class="hl-float-layer pointer-events-none absolute inset-0 z-10 *:pointer-events-auto"></div></div></section><section data-hl-block="blk-home-listings" data-hl-block-type="listings" lang="fr" dir="ltr" class="hl-blk hl-blk-listings bg-site-well"><div class="relative mx-auto w-full max-w-site-content"><div class="mb-4.5 flex items-center gap-2.5"><h2 class="text-site-lg" data-hl-field="title">Nos chambres</h2><span class="inline-flex items-center gap-1.25 rounded-site-pill border border-dashed border-site-accent/50 bg-site-accent-soft px-2 py-0.75 font-mono text-site-xs text-site-accent">DB rooms</span></div><div class="grid grid-cols-1 gap-3.5 md:grid-cols-2 lg:grid-cols-3" data-hl-field="cards"><a class="overflow-hidden rounded-site border border-site-hairline bg-site-card block" href="/rooms/olivier"><div class="relative overflow-hidden bg-site-media-fill aspect-[4/3] rounded-none"><img class="size-full object-cover" alt="Chambre Olivier" decoding="async" loading="lazy" src="/media/asset-room-2/v1/olivier.jpg" width="1200" height="900"/></div><div class="p-3"><h3 class="mb-0.75 font-[inherit] text-site-sm">Chambre Olivier</h3><p class="text-site-xs text-site-ink-soft">Jardin · 2 personnes</p><p class="mt-2.25 text-site-sm text-site-accent">95</p></div></a><a class="overflow-hidden rounded-site border border-site-hairline bg-site-card block" href="/rooms/jasmin"><div class="relative overflow-hidden bg-site-media-fill aspect-[4/3] rounded-none"><img class="size-full object-cover" alt="Chambre Jasmin" decoding="async" loading="lazy" src="/media/asset-room-1/v1/jasmin.jpg" width="1200" height="900"/></div><div class="p-3"><h3 class="mb-0.75 font-[inherit] text-site-sm">Chambre Jasmin</h3><p class="text-site-xs text-site-ink-soft">Patio · 2 personnes</p><p class="mt-2.25 text-site-sm text-site-accent">120</p></div></a><a class="overflow-hidden rounded-site border border-site-hairline bg-site-card block" href="/rooms/terrasse"><div class="relative overflow-hidden bg-site-media-fill aspect-[4/3] rounded-none"><img class="size-full object-cover" alt="Suite Terrasse" decoding="async" loading="lazy" src="/media/asset-room-3/v1/terrasse.jpg" width="1200" height="900"/></div><div class="p-3"><h3 class="mb-0.75 font-[inherit] text-site-sm">Suite Terrasse</h3><p class="text-site-xs text-site-ink-soft">Terrasse · 3 personnes</p><p class="mt-2.25 text-site-sm text-site-accent">180</p></div></a></div><div class="hl-float-layer pointer-events-none absolute inset-0 z-10 *:pointer-events-auto"></div></div></section><section data-hl-block="blk-home-quote" data-hl-block-type="quote" lang="fr" dir="ltr" class="hl-blk hl-blk-quote text-center"><figure class="relative mx-auto w-full max-w-site-content"><blockquote class="mb-3.5 max-w-[30ch] font-heading text-[length:calc(var(--site-type-lg)*0.92)] leading-[1.35] mx-auto" data-hl-field="quote"><p>“On est arrivés pour deux nuits, on est restés une semaine.”</p></blockquote><figcaption class="text-site-xs tracking-[0.08em] text-site-ink-soft uppercase" data-hl-field="by">Léa &amp; Karim, Lyon</figcaption><div class="hl-float-layer pointer-events-none absolute inset-0 z-10 *:pointer-events-auto"></div></figure></section><section data-hl-block="blk-home-cta" data-hl-block-type="ctaBand" lang="fr" dir="ltr" class="hl-blk hl-blk-ctaBand bg-site-accent text-site-on-accent"><div class="relative mx-auto flex w-full max-w-site-content flex-wrap items-center gap-6"><div class="min-w-60 flex-1"><h2 class="mb-1.5 text-site-lg" data-hl-field="title">Réservez votre séjour</h2><p class="text-site-sm opacity-82" data-hl-field="description">Réponse sous 24 h.</p></div><a class="inline-flex cursor-pointer items-center gap-2 whitespace-nowrap rounded-site border border-transparent px-4.25 py-2.25 font-[inherit] text-site-sm leading-[1.2] hover:no-underline hover:brightness-95 disabled:cursor-not-allowed disabled:opacity-55 aria-disabled:cursor-not-allowed aria-disabled:opacity-55 border-site-on-accent bg-site-on-accent text-site-accent" href="/contact" data-hl-field="buttonLabel">Demander une date</a><div class="hl-float-layer pointer-events-none absolute inset-0 z-10 *:pointer-events-auto"></div></div></section></div>"`;

