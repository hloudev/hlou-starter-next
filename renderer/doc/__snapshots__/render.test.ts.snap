;--fe-md:32px;--ft-md:32px;--fb-md:auto;--ftx-md:0px;--fty-md:0px;--fw-md:auto;--fz-md:1"><div class="hl-slot grid content-start gap-[var(--site-slot-gap,18px)] hl-float__content"><div data-hl-block="blk-home-hero-badge-label" data-hl-block-type="button" lang="en" dir="ltr" class="hl-blk hl-blk-button [--site-pad-y:18px]"><div class="mx-auto flex w-full max-w-site-content flex-wrap gap-2.5 in-[.hl-slot]:max-w-none"><span class="inline-flex cursor-pointer items-center gap-2 whitespace-nowrap rounded-site border border-transparent px-4.25 py-2.25 font-[inherit] text-site-sm leading-[1.2] hover:no-underline hover:brightness-95 disabled:cursor-not-allowed disabled:opacity-55 aria-disabled:cursor-not-allowed aria-disabled:opacity-55 border-site-on-accent bg-site-on-accent text-site-accent" aria-disabled="true" data-hl-field="label">Nouveau</span></div></div></div></div></div></div></section><section data-hl-block="blk-home-stats" data-hl-block-type="stats" lang="en" dir="ltr" class="hl-blk hl-blk-stats py-6.5 border-y border-site-hairline"><div class="relative mx-auto w-full max-w-site-content"><dl class="grid grid-cols-2 gap-5 max-[390px]:grid-cols-1 md:grid-cols-[repeat(var(--site-stats-cols,4),1fr)]" style="--site-stats-cols:4" data-hl-field="items"><div class="" data-hl-field="items[0]"><dd class="font-heading text-[length:calc(var(--site-type-lg)*1.15)] leading-none">4</dd><dt class="mt-1 text-site-xs text-site-ink-soft">chambres</dt></div><div class="" data-hl-field="items[1]"><dd class="font-heading text-[length:calc(var(--site-type-lg)*1.15)] leading-none">1932</dd><dt class="mt-1 text-site-xs text-site-ink-soft">année</dt></div><div class="" data-hl-field="items[2]"><dd class="font-heading text-[length:calc(var(--site-type-lg)*1.15)] leading-none">10 min</dd><dt class="mt-1 text-site-xs text-site-ink-soft">de la médina</dt></div><div class="" data-hl-field="items[3]"><dd class="font-heading text-[length:calc(var(--site-type-lg)*1.15)] leading-none">4,9</dd><dt c