{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hlou.app/schemas/site-spec/v1/site.schema.json",
  "title": "Hlou site spec, format 1: hlou/site/site.json",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "The JSON Schema this file follows.",
      "type": "string"
    },
    "format": {
      "type": "number",
      "const": 1
    },
    "project": {
      "type": "object",
      "properties": {
        "sourceLocale": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
        },
        "indexable": {
          "type": "boolean"
        },
        "site": {
          "type": "object",
          "properties": {
            "icon": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^\\/media\\/[A-Za-z0-9._-]+\\/[A-Za-z0-9._-]+$",
                  "description": "A medium by path: `/media/<dir>/<file>` is the file `public/media/<dir>/<file>`."
                },
                {
                  "type": "null"
                }
              ]
            },
            "titleTemplate": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "themeColor": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{6}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "social": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "string",
                  "maxLength": 200
                },
                "facebook": {
                  "type": "string",
                  "maxLength": 200
                },
                "instagram": {
                  "type": "string",
                  "maxLength": 200
                },
                "linkedin": {
                  "type": "string",
                  "maxLength": 200
                },
                "youtube": {
                  "type": "string",
                  "maxLength": 200
                },
                "tiktok": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "attribution": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "tone": {
              "type": "string",
              "enum": [
                "light",
                "dark",
                "glass",
                "brand",
                "mono-ink",
                "mono-paper",
                "text-only",
                "mark-only"
              ]
            },
            "adaptive": {
              "type": "boolean"
            },
            "size": {
              "type": "string",
              "enum": ["s", "m", "l"]
            },
            "shape": {
              "type": "string",
              "enum": ["pill", "rounded"]
            },
            "align": {
              "type": "string",
              "enum": ["start", "center", "end"]
            },
            "mode": {
              "type": "string",
              "enum": ["inline", "float"]
            },
            "edge": {
              "type": "string",
              "enum": ["bottom", "top"]
            },
            "offsetX": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            },
            "offsetY": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["sourceLocale"],
      "additionalProperties": false
    },
    "locales": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "required": ["code"],
        "additionalProperties": false
      }
    },
    "theme": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "colors": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string",
                "pattern": "^#(?:[0-9a-f]{3}|[0-9a-f]{6})$"
              },
              "dark": {
                "type": "string",
                "pattern": "^#(?:[0-9a-f]{3}|[0-9a-f]{6})$"
              }
            },
            "required": ["key", "value"],
            "additionalProperties": false
          }
        },
        "fonts": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "label": {
                "type": "string"
              },
              "source": {
                "type": "string",
                "enum": ["google", "custom"]
              },
              "family": {
                "type": "string",
                "pattern": "^[\\p{L}\\p{N}][\\p{L}\\p{N} ._-]{0,119}$"
              },
              "src": {
                "type": "string",
                "pattern": "^\\/media\\/[A-Za-z0-9._-]+\\/[A-Za-z0-9._-]+$",
                "description": "A medium by path: `/media/<dir>/<file>` is the file `public/media/<dir>/<file>`."
              },
              "weights": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "weight": {
                "type": "integer",
                "minimum": 100,
                "maximum": 900,
                "multipleOf": 100
              },
              "size": {
                "type": "number",
                "minimum": 6,
                "maximum": 240
              },
              "lineHeight": {
                "type": "number",
                "minimum": 0.5,
                "maximum": 4
              },
              "letterSpacing": {
                "type": "number",
                "minimum": -0.2,
                "maximum": 1
              },
              "localeOverrides": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "source": {
                      "type": "string",
                      "enum": ["google", "custom"]
                    },
                    "family": {
                      "type": "string",
                      "pattern": "^[\\p{L}\\p{N}][\\p{L}\\p{N} ._-]{0,119}$"
                    },
                    "src": {
                      "type": "string",
                      "pattern": "^\\/media\\/[A-Za-z0-9._-]+\\/[A-Za-z0-9._-]+$",
                      "description": "A medium by path: `/media/<dir>/<file>` is the file `public/media/<dir>/<file>`."
                    },
                    "weights": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": -9007199254740991,
                        "maximum": 9007199254740991
                      }
                    }
                  },
                  "required": ["source", "family"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["key", "source", "family"],
            "additionalProperties": false
          }
        },
        "density": {
          "type": "string",
          "enum": ["tight", "base", "roomy"]
        },
        "radius": {
          "anyOf": [
            {
              "type": "number",
              "const": 0
            },
            {
              "type": "number",
              "const": 4
            },
            {
              "type": "number",
              "const": 10
            },
            {
              "type": "number",
              "const": 20
            }
          ]
        },
        "typeScale": {
          "type": "object",
          "properties": {
            "xs": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "sm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "md": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "lg": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "xl": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": ["xs", "sm", "md", "lg", "xl"],
          "additionalProperties": false
        },
        "schemes": {
          "maxItems": 12,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,39}$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "roles": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string",
                      "pattern": "^#(?:[0-9a-f]{3}|[0-9a-f]{6})$"
                    },
                    "dark": {
                      "type": "string",
                      "pattern": "^#(?:[0-9a-f]{3}|[0-9a-f]{6})$"
                    }
                  },
                  "required": ["value"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["key", "name", "roles"],
            "additionalProperties": false
          }
        }
      },
      "required": ["colors", "fonts"],
      "additionalProperties": false
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": ["header", "footer", "section"]
          },
          "document": {
            "type": "object",
            "properties": {
              "root": {
                "type": "string",
                "minLength": 1
              },
              "rootProps": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {}
              },
              "nodes": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "type": {
                      "type": "string",
                      "minLength": 1
                    },
                    "parent": {
                      "type": ["string", "null"]
                    },
                    "slot": {
                      "type": "string"
                    },
                    "order": {
                      "type": "string"
                    },
                    "props": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    },
                    "name": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    },
                    "section": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
                    },
                    "variant": {
                      "type": "string"
                    },
                    "design": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "string"
                      }
                    },
                    "instanceOf": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "overrides": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      }
                    },
                    "place": {
                      "type": "object",
                      "properties": {
                        "base": {
                          "type": "object",
                          "properties": {
                            "colStart": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 12
                            },
                            "colSpan": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 12
                            },
                            "rowStart": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 48
                            },
                            "rowSpan": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 24
                            },
                            "z": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 10
                            },
                            "rotate": {
                              "type": "integer",
                              "minimum": -180,
                              "maximum": 180
                            }
                          },
                          "required": ["colStart", "colSpan", "rowStart", "rowSpan"],
                          "additionalProperties": false
                        },
                        "md": {
                          "type": "object",
                          "properties": {
                            "colStart": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 12
                            },
                            "colSpan": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 12
                            },
                            "rowStart": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 48
                            },
                            "rowSpan": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 24
                            },
                            "z": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 10
                            },
                            "rotate": {
                              "type": "integer",
                              "minimum": -180,
                              "maximum": 180
                            }
                          },
                          "required": ["colStart", "colSpan", "rowStart", "rowSpan"],
                          "additionalProperties": false
                        },
                        "lg": {
                          "type": "object",
                          "properties": {
                            "colStart": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 12
                            },
                            "colSpan": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 12
                            },
                            "rowStart": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 48
                            },
                            "rowSpan": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 24
                            },
                            "z": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 10
                            },
                            "rotate": {
                              "type": "integer",
                              "minimum": -180,
                              "maximum": 180
                            }
                          },
                          "required": ["colStart", "colSpan", "rowStart", "rowSpan"],
                          "additionalProperties": false
                        },
                        "xl": {
                          "type": "object",
                          "properties": {
                            "colStart": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 12
                            },
                            "colSpan": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 12
                            },
                            "rowStart": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 48
                            },
                            "rowSpan": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 24
                            },
                            "z": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 10
                            },
                            "rotate": {
                              "type": "integer",
                              "minimum": -180,
                              "maximum": 180
                            }
                          },
                          "required": ["colStart", "colSpan", "rowStart", "rowSpan"],
                          "additionalProperties": false
                        }
                      },
                      "additionalProperties": false
                    },
                    "hidden": {
                      "type": "boolean"
                    },
                    "when": {
                      "minItems": 1,
                      "maxItems": 4,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "path": {
                            "type": "string"
                          },
                          "op": {
                            "type": "string",
                            "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "in", "truthy", "empty"]
                          },
                          "value": {}
                        },
                        "required": ["path", "op"]
                      }
                    }
                  },
                  "required": ["id", "type", "parent", "slot", "order", "props"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["root", "rootProps", "nodes"],
            "additionalProperties": false
          }
        },
        "required": ["key", "name", "kind", "document"],
        "additionalProperties": false
      }
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z0-9]+(?:[._-][a-zA-Z0-9]+)*$"
          },
          "kind": {
            "type": "string",
            "enum": ["text", "richtext", "heading", "media", "navigation", "dynamic"]
          },
          "required": {
            "type": "boolean"
          },
          "localizable": {
            "type": "boolean"
          },
          "collection": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "query": {
            "type": "object",
            "properties": {
              "filter": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "additionalProperties": {
                  "type": ["string", "number", "boolean", "null"]
                }
              },
              "sort": {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "direction": {
                    "type": "string",
                    "enum": ["asc", "desc"]
                  }
                },
                "required": ["field"],
                "additionalProperties": false
              },
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            },
            "additionalProperties": false
          }
        },
        "required": ["key", "kind"],
        "additionalProperties": false
      }
    }
  },
  "required": ["format", "project", "locales", "theme"],
  "additionalProperties": false
}
