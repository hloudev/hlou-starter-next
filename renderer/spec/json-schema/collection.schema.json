{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hlou.app/schemas/site-spec/v1/collection.schema.json",
  "title": "Hlou site spec, format 1: hlou/site/collections/<key>.json",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "The JSON Schema this file follows.",
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": ["string", "null"]
    },
    "icon": {
      "type": ["string", "null"]
    },
    "tone": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["lime", "sand", "violet", "pink", "peach", "mauve"]
        },
        {
          "type": "null"
        }
      ]
    },
    "localized": {
      "type": "boolean"
    },
    "singleton": {
      "type": "boolean"
    },
    "websiteWritable": {
      "type": "boolean"
    },
    "delivery": {
      "type": "string",
      "enum": ["static", "live"]
    },
    "position": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "richtext",
              "slug",
              "number",
              "boolean",
              "date",
              "media",
              "select",
              "email",
              "relation",
              "money",
              "daterange",
              "phone",
              "country"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "localized": {
            "type": "boolean"
          },
          "default": {},
          "options": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "relation": {
            "type": "object",
            "properties": {
              "collection": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "cardinality": {
                "type": "string",
                "enum": ["one", "many"]
              }
            },
            "required": ["collection", "cardinality"],
            "additionalProperties": false
          }
        },
        "required": ["key", "label", "type"],
        "additionalProperties": false
      }
    },
    "forms": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "label": {
            "type": "string"
          },
          "fieldMap": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "primary": {
            "type": "boolean"
          }
        },
        "required": ["key", "label", "fieldMap"],
        "additionalProperties": false
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "status": {
            "type": "string",
            "enum": ["draft", "published", "archived"]
          },
          "environment": {
            "type": "string",
            "enum": ["production", "preview"]
          },
          "slug": {
            "type": ["string", "null"]
          },
          "publishedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              {
                "type": "null"
              }
            ]
          },
          "data": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "additionalProperties": {}
          }
        },
        "required": ["key", "data"],
        "additionalProperties": false
      }
    }
  },
  "required": ["name", "fields"],
  "additionalProperties": false
}
